# URL pubblico del sito (canonical, sitemap, Open Graph)
PUBLIC_URL=https://porscheclubtrinacria.it
# Email via API Brevo (mittente verificato su Brevo)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Porsche Club Trinacria
# Destinatario dei messaggi del modulo contatti
CONTACT_TO=porscheclubtrinacria@gmail.com
# Alert errori
ALERT_EMAIL=info@simonescaffidi.it
# Token per POST /admin/alert-test (header x-alert-token)
ALERT_TEST_TOKEN=
# Google Analytics 4 (G-XXXX) e codice di verifica Google Search Console
GA4_ID=
GSC_VERIFICATION=
TZ=Europe/Rome

# Album foto degli eventi dalla pagina Facebook del Club (Graph API).
# Le foto non sono salvate sul server: si usano gli URL della CDN di Facebook, riletti ogni ora.
# Token della pagina (permesso pages_read_engagement). Senza token il sito mostra gli eventi statici di content/eventi.json.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=porscheclubtrinacria
META_GRAPH_VERSION=v21.0
